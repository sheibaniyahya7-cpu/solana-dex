# ─── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
nginx/ssl/

# ─── Python ───────────────────────────────────────────────────────────────────
# The build-artifact directory names below are anchored on purpose. Unanchored,
# `lib/` matches at any depth and silently excluded frontend/src/lib, so
# @/lib/api and @/lib/utils were never committed and the frontend failed to
# compile from a fresh clone.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.installed.cfg
MANIFEST
.venv/
venv/
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/env/
/ENV/
backend/build/
backend/dist/
backend/lib/
backend/var/
backend/.venv/
backend/venv/
backend/env/

# ─── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ─── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ─── Docker ───────────────────────────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
