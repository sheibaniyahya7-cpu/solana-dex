# ─── Copy this file to .env and fill in your values ──────────────────────────
# cp .env.example .env

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-this-to-a-random-64-char-string-before-production

# Required by write endpoints when APP_ENV=production. Clients send it as the
# X-API-Key header. Generate one with:
#   python -c "from app.core.security import generate_api_key; print(generate_api_key())"
API_KEY=

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=dexuser
POSTGRES_PASSWORD=dexpassword
POSTGRES_DB=dextrader
DATABASE_URL=postgresql+asyncpg://dexuser:dexpassword@localhost:5432/dextrader

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6379/0

# ─── Solana RPC ───────────────────────────────────────────────────────────────
# Public endpoint (rate-limited). Use Helius for production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com

# ─── Helius API ───────────────────────────────────────────────────────────────
# Get your key at: https://www.helius.dev/
HELIUS_API_KEY=your_helius_api_key_here

# ─── DexScreener API ──────────────────────────────────────────────────────────
# No key needed for public endpoints. Paid plan for higher limits.
# https://docs.dexscreener.com/

# ─── Birdeye API ──────────────────────────────────────────────────────────────
# Get your key at: https://birdeye.so/
BIRDEYE_API_KEY=your_birdeye_api_key_here

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_ADVANCED=gpt-4o

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Create a bot via @BotFather and get the token.
# Get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ALERT_CHAT_ID=your_high_priority_chat_id_here

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── Celery Flower (monitoring UI) ────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=flowerpassword

# ─── pgAdmin (dev only) ───────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@dex.local
PGADMIN_PASSWORD=pgadminpassword

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text    # text (dev) | json (prod)
